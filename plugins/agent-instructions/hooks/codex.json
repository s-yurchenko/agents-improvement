{
  "hooks": {
    "SessionStart": [{
      "matcher": "^(startup|resume|clear|compact|fork)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\" codex",
        "timeout": 30,
        "statusMessage": "Загрузка общих инструкций",
        "additionalContextLimit": 0
      }]
    }]
  }
}
